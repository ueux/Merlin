{
  "schema_version": "1.0.0",
  "module": {
    "id": "chassis-plate",
    "name": "Chassis Plate",
    "version": "0.7.0",
    "category": "structure",
    "vendor": "robotforge",
    "description": "Modular aluminum chassis plate with an actuator seat (4xM4 30x30), a battery bracket (4xM4 60x40), and two 30 mm tube link mounts.",
    "tags": ["structural", "frame", "aluminum"]
  },
  "licenses": {
    "hardware": { "id": "BSD-3-Clause" }
  },
  "mechanical": {
    "mass_kg": 0.6,
    "com": [0.1, 0.08, 0.01],
    "inertia": { "ixx": 0.0031, "iyy": 0.0022, "izz": 0.0050, "ixy": 0, "ixz": 0, "iyz": 0 },
    "bounding_box_m": { "x": 0.2, "y": 0.16, "z": 0.04 },
    "frames": [
      { "id": "body", "origin": { "xyz": [0, 0, 0], "rpy": [0, 0, 0] } },
      { "id": "seat", "origin": { "xyz": [0.05, 0.05, 0.02], "rpy": [0, 0, 0] } },
      { "id": "batt", "origin": { "xyz": [-0.05, 0.0, 0.02], "rpy": [0, 0, 0] } },
      { "id": "link_a", "origin": { "xyz": [0.15, 0.0, 0.0], "rpy": [0, 0, 0] } },
      { "id": "link_b", "origin": { "xyz": [-0.15, 0.0, 0.0], "rpy": [0, 0, 0] } }
    ],
    "interfaces": [
      {
        "id": "iface-seat",
        "kind": "bracket",
        "side": "female",
        "plane": "seat",
        "offset": { "xyz": [0, 0, 0], "rpy": [0, 0, 0] },
        "normal": [0, 0, -1],
        "bolt_pattern": { "count": 4, "size": "M4", "layout": "rectangular", "pitch_x_mm": 30, "pitch_y_mm": 30 },
        "load": { "axial_n": 300, "moment_nm": 12.0 },
        "fasteners": [ { "spec": "M4x10 SHCS", "qty": 4 } ],
        "compatible_with": ["pattern:4xM4_on_30x30_grid"],
        "tags": ["actuator-seat"]
      },
      {
        "id": "iface-batt",
        "kind": "bracket",
        "side": "female",
        "plane": "batt",
        "offset": { "xyz": [0, 0, 0], "rpy": [0, 0, 0] },
        "normal": [0, 0, -1],
        "bolt_pattern": { "count": 4, "size": "M4", "layout": "rectangular", "pitch_x_mm": 60, "pitch_y_mm": 40 },
        "load": { "axial_n": 250, "moment_nm": 10.0 },
        "fasteners": [ { "spec": "M4x10 SHCS", "qty": 4 } ],
        "compatible_with": ["pattern:4xM4_on_60x40_grid"],
        "tags": ["battery-bracket"]
      },
      {
        "id": "iface-link-a",
        "kind": "tube_clamp",
        "side": "female",
        "plane": "link_a",
        "offset": { "xyz": [0, 0, 0], "rpy": [0, 0, 0] },
        "normal": [1, 0, 0],
        "compatible_with": ["tube:od30"],
        "tags": ["link-mount"]
      },
      {
        "id": "iface-link-b",
        "kind": "tube_clamp",
        "side": "female",
        "plane": "link_b",
        "offset": { "xyz": [0, 0, 0], "rpy": [0, 0, 0] },
        "normal": [-1, 0, 0],
        "compatible_with": ["tube:od30"],
        "tags": ["link-mount"]
      }
    ],
    "assets": {
      "step": "assets/chassis.step",
      "gltf": "assets/chassis.gltf"
    }
  },
  "software": {
    "urdf": {
      "fragment": "urdf/chassis.macro.xacro",
      "macro": "chassis_plate_macro",
      "params": [
        { "name": "prefix" },
        { "name": "parent_link" }
      ]
    }
  },
  "compat": {
    "mates_with": ["tube:od30", "pattern:4xM4_on_30x30_grid", "pattern:4xM4_on_60x40_grid"],
    "power_budget": { "consumes_w": 0, "provides_w": 0 },
    "environment": { "temp_min_c": -20, "temp_max_c": 70 }
  }
}
