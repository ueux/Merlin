        "repo": { "url": "https://git.example.com/quadruped/quadruped_control.git", "branch": "main" },
        "ros": {
          "distro": "jazzy",
          "packages": ["quadruped_control", "gait_planner", "state_estimator"],
          "dependencies": ["ros-gz", "ros2-control", "xacro"]
