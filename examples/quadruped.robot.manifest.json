        "language": ["cpp", "python"],
        "frameworks": ["eigen"],
        "build": {
          "system": "colcon",
          "pipeline": ".ci/build_and_simtest.yml",
          "status": "passing",
          "last_run": "2026-09-20T17:45:00Z"
        },
        "devcontainer": ".devcontainer/devcontainer.json"
      },
      {
        "id": "motor-driver-firmware",
        "name": "Motor Driver Firmware",
        "repo": { "url": "https://git.example.com/quadruped/motor_driver_fw.git", "branch": "main" },
        "language": ["c"],
        "build": { "system": "make", "pipeline": ".ci/build.yml", "status": "passing" }
      },
      {
        "id": "perception",
        "name": "Perception Stack",
        "repo": { "url": "https://git.example.com/quadruped/perception.git", "branch": "main" },
