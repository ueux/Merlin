{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.robotforge/v1/robot-manifest.schema.json",
  "title": "RobotManifest",
  "$comment": "The Robot Manifest is the versioned single source of truth for a robot. It references artifacts (native files + derivatives) rather than containing them. Versioning policy: additive, optional properties may be introduced in minor schema releases; breaking changes bump schema_version to 2.0.0. The schema deliberately avoids assuming a tree-structured kinematics model so URDF 2.x (closed kinematic loops) can be adopted without a breaking change.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "robot", "systems"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "robot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "version": { "$ref": "#/$defs/semver" },
        "status": {
          "type": "string",
          "enum": ["concept", "prototype", "beta", "released", "retired"],
          "default": "concept"
        },
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/person" }
        },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "licenses": { "$ref": "#/$defs/licenses" },
    "systems": {
      "type": "object",
      "additionalProperties": false,
      "required": ["software"],
      "properties": {
        "mechanical": {
          "type": "array",
          "items": { "$ref": "#/$defs/mechanicalArtifact" }
        },
        "electrical": {
          "type": "array",
          "items": { "$ref": "#/$defs/electricalArtifact" }
        },
        "software": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/softwarePackage" }
        },
        "simulation": { "$ref": "#/$defs/simulation" },
        "testing": { "$ref": "#/$defs/testing" }
      }
    },
    "modules": {
      "type": "array",
      "items": { "$ref": "#/$defs/moduleUse" },
      "description": "Prebuilt modules this robot is composed from. Versions are pinned for reproducibility; the platform resolves each entry against the module registry."
    },
    "links": {
      "type": "array",
      "items": { "$ref": "#/$defs/link" },
      "description": "Typed, bidirectional traceability edges across domains (the 'graph' part of the single source of truth)."
    },
    "publication": { "$ref": "#/$defs/publication" },
    "extensions": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z0-9-]+(\\.[a-z0-9-]+)+$": {}
      },
      "description": "Team/vendor-specific extension namespace. Keys must be reverse-DNS style (e.g. 'com.acme.qa'); the platform never interprets these."
    }
  },
  "if": {
    "properties": {
      "publication": {
        "properties": { "status": { "const": "public" } },
        "required": ["status"]
      }
    },
    "required": ["publication"]
  },
  "then": {
    "required": ["licenses"],
    "properties": {
      "licenses": { "$ref": "#/$defs/licenses" }
    }
  },

  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 64,
      "description": "Lowercase kebab-case identifier, stable across renames."
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$",
      "description": "Semantic version per semver.org."
    },
    "rosName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "maxLength": 64,
      "description": "Lowercase ROS-compliant name (snake_case allowed). Used where the value maps to ROS frames, node names, or instance prefixes."
    },
    "relPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\.\\./).+",
      "description": "Path relative to the manifest file. No absolute paths, no parent-directory traversal."
    },
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string" }
      }
    },
    "licenseSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "SPDX expression for software (e.g. 'MIT'), CERN-OHL-P-2.0 / CERN-OHL-S-2.0 for hardware, CC-BY-SA-4.0 for docs."
        },
        "url": { "type": "string", "format": "uri" },
        "note": { "type": "string" }
      }
    },
    "licenses": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hardware": { "$ref": "#/$defs/licenseSpec" },
        "software": { "$ref": "#/$defs/licenseSpec" },
        "docs": { "$ref": "#/$defs/licenseSpec" }
      },
      "minProperties": 1,
      "description": "Per-artifact-domain licensing. Mixed robots can license hardware, software, and docs differently."
    },
    "inertia": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ixx", "iyy", "izz"],
      "properties": {
        "ixx": { "type": "number" },
        "iyy": { "type": "number" },
        "izz": { "type": "number" },
        "ixy": { "type": "number", "default": 0 },
        "ixz": { "type": "number", "default": 0 },
        "iyz": { "type": "number", "default": 0 }
      },
      "description": "kg·m^2 about the center of mass, expressed in the artifact's frame."
    },
    "materialRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["material_id"],
      "properties": {
        "material_id": { "$ref": "#/$defs/slug" },
        "grade": { "type": "string", "description": "e.g. '6061-T6'." },
        "spec": { "type": "string", "description": "e.g. 'ASTM B209'." }
      }
    },
    "mechanicalArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "cad", "derivatives"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "name": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": ["assembly", "part", "drawing", "weldment", "other"],
          "default": "part"
        },
        "cad": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "file"],
          "properties": {
            "format": {
              "type": "string",
              "enum": ["sldasm", "sldprt", "slddrw", "step", "iges", "stl", "f3d", "fcstd", "py", "other"]
            },
            "file": { "$ref": "#/$defs/relPath" }
          }
        },
        "derivatives": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "step": { "$ref": "#/$defs/relPath" },
            "gltf": { "$ref": "#/$defs/relPath" },
            "stl": { "$ref": "#/$defs/relPath" },
            "pdf": { "$ref": "#/$defs/relPath" }
          },
          "description": "Generated viewables/review artifacts. May be empty in authored manifests; the platform pipeline fills them and flags stale ones when the native file changes."
        },
        "bom": { "$ref": "#/$defs/relPath" },
        "mass_kg": { "type": "number", "exclusiveMinimum": 0 },
        "inertia": { "$ref": "#/$defs/inertia" },
        "material": { "$ref": "#/$defs/materialRef" }
      }
    },
    "electricalArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "project"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "name": { "type": "string", "minLength": 1 },
        "project": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "file"],
          "properties": {
            "format": {
              "type": "string",
              "enum": ["prjpcb", "kicad_pro", "eagle", "easyeda", "orcad", "other"]
            },
            "file": { "$ref": "#/$defs/relPath" }
          }
        },
        "git_repo": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url"],
          "properties": {
            "url": { "type": "string", "format": "uri" },
            "branch": { "type": "string" },
            "tag": { "type": "string" }
          },
          "description": "One git repository per PCBA; binary SchDoc/PcbDoc are lock-checkout, text files branch/merge."
        },
        "derivatives": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "gerbers": { "$ref": "#/$defs/relPath" },
            "render": { "$ref": "#/$defs/relPath" },
            "bom_csv": { "$ref": "#/$defs/relPath" }
          }
        },
        "mcu_firmware": {
          "type": "string",
          "description": "id of a systems.software entry that hosts firmware for this board."
        }
      }
    },
    "softwarePackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "repo"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "name": { "type": "string", "minLength": 1 },
        "repo": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url"],
          "properties": {
            "url": { "type": "string", "format": "uri" },
            "branch": { "type": "string" },
            "tag": { "type": "string" },
            "path": { "$ref": "#/$defs/relPath", "description": "Subdirectory within a monorepo." }
          }
        },
        "ros": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "distro": {
              "type": "string",
              "enum": ["humble", "iron", "jazzy", "rolling", "none"]
            },
            "packages": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "dependencies": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "description": "rosdep keys beyond package.xml declarations."
            }
          }
        },
        "language": {
          "type": "array",
          "items": { "type": "string", "enum": ["c", "cpp", "python", "rust", "java", "other"] }
        },
        "frameworks": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "e.g. pytorch, tensorflow, opencv."
        },
        "build": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "system": { "type": "string", "enum": ["colcon", "catkin", "cmake", "make", "cargo", "none"] },
            "pipeline": { "$ref": "#/$defs/relPath", "description": "CI pipeline definition (e.g. Gitea Actions / GitHub Actions workflow)." },
            "status": { "type": "string", "enum": ["unknown", "building", "passing", "failing"], "default": "unknown" },
            "last_run": { "type": "string", "format": "date-time" }
          }
        },
        "devcontainer": { "$ref": "#/$defs/relPath" }
      }
    },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "robot_description": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "xacro": { "$ref": "#/$defs/relPath" },
            "urdf": { "$ref": "#/$defs/relPath" },
            "sdf": { "$ref": "#/$defs/relPath" },
            "srdf": { "$ref": "#/$defs/relPath" },
            "format_note": {
              "type": "string",
              "description": "e.g. 'xacro is the source of truth; URDF is generated at build time'."
            }
          }
        },
        "worlds": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "file", "engine"],
            "properties": {
              "id": { "$ref": "#/$defs/slug" },
              "file": { "$ref": "#/$defs/relPath" },
              "engine": {
                "type": "string",
                "enum": ["gzsim", "gazebo-classic", "webots", "coppelia", "isaac", "mujoco", "unity", "custom"]
              },
              "engine_version": { "type": "string" }
            }
          }
        },
        "moveit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "config": { "$ref": "#/$defs/relPath", "description": "MoveIt configuration package directory." },
            "planning_groups": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "unity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "asset": { "$ref": "#/$defs/relPath" },
            "project": { "type": "string" },
            "note": { "type": "string" }
          },
          "description": "Optional photoreal visualization tier (ROS-TCP-Connector + URDF Importer)."
        },
        "sim_profiles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "engine"],
            "properties": {
              "id": { "$ref": "#/$defs/slug" },
              "engine": {
                "type": "string",
                "enum": ["gzsim", "gazebo-classic", "webots", "coppelia", "isaac", "mujoco", "unity", "custom"]
              },
              "gpu": { "type": "boolean", "default": false },
              "gpu_profile": { "type": "string", "description": "e.g. 't4', 'l4', 'rtx-4090'." },
              "headless": { "type": "boolean", "default": true },
              "entrypoint": { "$ref": "#/$defs/relPath", "description": "Launch file or script that boots the sim session." }
            }
          }
        }
      }
    },
    "testing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "material_tests": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "standard", "data"],
            "properties": {
              "id": { "$ref": "#/$defs/slug" },
              "standard": { "type": "string", "description": "e.g. 'ASTM E8/E8M', 'ASTM E23', 'ASTM E466'." },
              "data": { "$ref": "#/$defs/relPath", "description": "Raw export (CSV) from Instron Bluehill / Zwick testXpert." },
              "report": { "$ref": "#/$defs/relPath" },
              "date": { "type": "string", "format": "date" },
              "material": { "$ref": "#/$defs/slug", "description": "Material database id; full batch/specimen records live in the platform DB." },
              "qualifies": {
                "type": "array",
                "items": { "$ref": "#/$defs/domainRef" },
                "description": "Mechanical artifacts this test provides evidence for."
              },
              "summary": {
                "type": "object",
                "description": "Headline typed results with SI units, e.g. yield_mpa, uts_mpa, elongation_pct."
              }
            }
          }
        },
        "test_runs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind"],
            "properties": {
              "id": { "$ref": "#/$defs/slug" },
              "kind": { "type": "string", "enum": ["sim", "hil", "unit", "integration", "field"] },
              "status": { "type": "string", "enum": ["pass", "fail", "skip", "running"], "default": "running" },
              "engine": { "type": "string" },
              "robot_version": { "$ref": "#/$defs/semver" },
              "artifacts": {
                "type": "array",
                "items": { "$ref": "#/$defs/relPath" },
                "description": "Recordings (MCAP), logs, plots."
              },
              "report": { "$ref": "#/$defs/relPath" },
              "date": { "type": "string", "format": "date" }
            }
          }
        }
      }
    },
    "domainRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "id"],
      "properties": {
        "domain": {
          "type": "string",
          "enum": ["mechanical", "electrical", "software", "simulation", "testing", "module", "material"]
        },
        "id": { "$ref": "#/$defs/slug" }
      },
      "description": "Stable cross-domain reference by (domain, id) — immune to array reordering."
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target", "relation"],
      "properties": {
        "source": { "$ref": "#/$defs/domainRef" },
        "target": { "$ref": "#/$defs/domainRef" },
        "relation": {
          "type": "string",
          "minLength": 1,
          "examples": ["mounts", "controls", "implements", "powered_by", "communicates_with", "qualifies", "derived_from", "validated_by"]
        }
      }
    },
    "moduleUse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module_id", "version"],
      "properties": {
        "module_id": { "$ref": "#/$defs/slug" },
        "version": { "$ref": "#/$defs/semver" },
        "instances": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "$ref": "#/$defs/rosName" },
              "config": {
                "type": "object",
                "description": "Instance-level overrides of the module's default attributes (node ids, gains, offsets)."
              }
            }
          }
        },
        "license_compatibility": {
          "type": "string",
          "enum": ["ok", "warning", "conflict"],
          "description": "Computed by the composition engine; not authored by hand."
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["private", "public"], "default": "private" },
        "readme": { "$ref": "#/$defs/relPath" },
        "website": { "type": "string", "format": "uri" },
        "changelog": { "$ref": "#/$defs/relPath" },
        "oshwa": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "certified": { "type": "boolean" },
            "certificate_url": { "type": "string", "format": "uri" }
          }
        }
      }
    }
  }
}
